VITE_WHATSAPP_SUPPORT_NUMBER=+573000000000

# ==========================================
# PROVEEDOR EXCLUSIVO DE EMAIL: RESEND (SUPABASE EDGE SECRETS)
# ==========================================
# IMPORTANTE DE SEGURIDAD:
# Las siguientes variables NO van en este archivo .env ni en el cliente React/Vite.
# Se configuran de manera segura y exclusiva en Supabase Edge Functions Secrets:
#
# Comando Supabase CLI para configurarlos:
# supabase secrets set RESEND_API_KEY=re_tu_api_key_aqui
# supabase secrets set RESEND_FROM_EMAIL="Manaure Vive <notificaciones@tudominio.com>"
# supabase secrets set PUBLIC_APP_URL="https://tudominio.com"
# supabase secrets set RESEND_WEBHOOK_SECRET=whsec_...
#
# Variables para backend / Supabase Edge Functions:
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# RESEND_TEMPLATE_PAYMENT_RECEIVED=
# RESEND_TEMPLATE_PAYMENT_APPROVED=
# RESEND_TEMPLATE_PAYMENT_REJECTED=
# PUBLIC_APP_URL=

