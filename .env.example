# ==============================================================================
# MANAURE VIVE — ARCHIVO DE VARIABLES DE ENTORNO DE EJEMPLO (.env.example)
# ==============================================================================
# IMPORTANTE: Copia este archivo como .env y coloca los valores de tu entorno.
# NUNCA subas archivos .env con credenciales reales a Git (ya ignorado en .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VARIABLES PÚBLICAS DEL FRONTEND (Visibles en el cliente React / Vite)
# Todas las variables accesibles en el navegador DEBEN comenzar con VITE_
# ------------------------------------------------------------------------------

# URL del proyecto Supabase (Project Settings > API)
VITE_SUPABASE_URL=https://tu-proyecto-id.supabase.co

# Llave anónima pública de Supabase (Project Settings > API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Cloud Name de Cloudinary (Dashboard de Cloudinary > Cloud Name)
VITE_CLOUDINARY_CLOUD_NAME=tu_cloud_name

# URL base canónica del portal web (usada para OpenGraph, Canonical y enlaces absolutos)
# En desarrollo: http://localhost:5173
# En producción: https://manaurevive.vercel.app o dominio propio
VITE_SITE_URL=http://localhost:5173

# Número de soporte por WhatsApp (Formato internacional: +57XXXXXXXXXX)
# Nota: Actúa como valor de respaldo (fallback) en caso de que la tabla 'system_settings'
# no tenga configurado el teléfono de atención de la plataforma.
VITE_WHATSAPP_SUPPORT_NUMBER=+573000000000

# ------------------------------------------------------------------------------
# 2. SECRETOS DE SERVIDOR / SUPABASE EDGE FUNCTIONS (NO VAN EN ESTE ARCHIVO .env)
# ------------------------------------------------------------------------------
# Las siguientes variables son PRIVADAS y se ejecutan exclusivamente en las Edge
# Functions de Supabase. NO deben agregarse al frontend ni exponerse en el build.
#
# Configuración mediante Supabase CLI:
#   supabase secrets set CRON_SECRET="tu_clave_secreta_para_cron_aqui"
#   supabase secrets set CLOUDINARY_CLOUD_NAME="tu_cloud_name"
#   supabase secrets set CLOUDINARY_API_KEY="tu_api_key"
#   supabase secrets set CLOUDINARY_API_SECRET="tu_api_secret"
#
# Proveedor de Correo Transaccional (Brevo / Sendinblue):
#   supabase secrets set BREVO_API_KEY="tu_brevo_api_key_aqui"
#   supabase secrets set BREVO_SENDER_EMAIL="notificaciones@rifamanaure.com"
#   supabase secrets set BREVO_SENDER_NAME="Manaure Vive"
#   supabase secrets set BREVO_REPLY_TO_EMAIL="soporte@rifamanaure.com"
# ------------------------------------------------------------------------------


